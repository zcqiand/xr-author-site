---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../BookCard.astro';
import { getCollection } from 'astro:content';
import { t, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const books = await getCollection('books', (e) => e.data.lang === lang);
const title = `${ui.nav.books} — ${ui.siteName}`;
---
<BaseLayout
  lang={lang}
  title={title}
  description={ui.viewAllBooks}
  path="/books/"
>
  <h1>{ui.nav.books}</h1>
  <ul class="book-grid">
    {books.map((b) => <BookCard lang={lang} book={b.data} />)}
  </ul>
</BaseLayout>
