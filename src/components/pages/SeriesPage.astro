---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../BookCard.astro';
import { getCollection } from 'astro:content';
import seriesData from '../../data/books-meta.json';
import { t, langPath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  seriesId: string;
}
const { lang, seriesId } = Astro.props;
const ui = t(lang);

const meta = (seriesData.series as Array<{ id: string; name: Record<string, string>; description: Record<string, string> }>)
  .find((s) => s.id === seriesId);
if (!meta) {
  throw new Error(`Series not found: ${seriesId}`);
}
const seriesName = meta.name[lang as keyof typeof meta.name] as string;
const seriesDesc = meta.description[lang as keyof typeof meta.description] as string;
const books = await getCollection('books', (e) => e.data.lang === lang && e.data.series === seriesId);
---
<BaseLayout lang={lang} title={`${seriesName} — ${ui.siteName}`} description={seriesDesc} path={`/series/${seriesId}/`}>
  <h1>{seriesName}</h1>
  <p class="muted">{seriesDesc}</p>
  <ul class="book-grid">
    {books.map((b) => <BookCard lang={lang} book={b.data} />)}
  </ul>
  <p><a href={langPath(lang, '/series/')}>← {ui.nav.series}</a></p>
</BaseLayout>
