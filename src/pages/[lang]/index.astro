---
import AuthorHome from '../../components/pages/AuthorHome.astro';
import { locales } from '../../i18n/utils';

export function getStaticPaths() {
  return locales.filter((l) => l !== 'en').map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
---
<AuthorHome lang={lang as any} />
